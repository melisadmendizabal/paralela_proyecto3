cache/
*.npy
*.npz

# --- Pesos de modelos entrenados (se regeneran al entrenar) ---
modelos/
checkpoints/
*.pt
*.pth
*.ckpt

# --- Credenciales (NUNCA subir) ---
kaggle.json
.env

# --- Entornos virtuales ---
venv/
.venv/
.venv313t/
env/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Perfilado de CUDA (archivos de Nsight/nvprof suelen ser muy pesados) ---
